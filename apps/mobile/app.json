{
  "expo": {
    "name": "Opinion",
    "slug": "opinion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opinion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.opinion.mobile",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.declared-age-range": true,
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "associatedDomains": [
        "applinks:opinion.example"
      ],
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "app.opinion.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#16181D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "opinion.example",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "opinion.example",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "opinion.example",
              "pathPrefix": "/f/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16181D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_IN_PHASE_0"
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.opinion.mobile",
          "widgets": [
            {
              "name": "DailyQuestion",
              "displayName": "Today’s question",
              "description": "The question everyone on Opinion is answering today.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
