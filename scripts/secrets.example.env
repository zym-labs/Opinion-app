# Copy to scripts/secrets.staging.env / secrets.production.env (gitignored) and fill in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Opinion <no-reply@yourdomain>
# Random, generated once, never changed after launch (campus email hashes depend on it):  openssl rand -base64 32
EMAIL_HASH_PEPPER=
# Sign in with Apple token revocation
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=app.opinion.mobile
# Contents of the .p8 key, with newlines written as \n
APPLE_PRIVATE_KEY=
# openssl rand -base64 32
APPLE_TOKEN_KEY=
# Device integrity: off | report (log only, default) | enforce. Switch to enforce after checking Admin → Integrity on real devices.
INTEGRITY_MODE=report
ANDROID_PACKAGE=app.opinion.mobile
# Google Cloud service account (Play Integrity API enabled) as one-line JSON
GOOGLE_SERVICE_ACCOUNT_JSON=
# true only on staging builds signed for development
APP_ATTEST_ALLOW_DEV=false
